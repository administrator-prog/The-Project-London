{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "WebWorker"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["middleware.ts", "api/**/*.ts", "lib/**/*.ts"]
}
