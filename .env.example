# ---------------------------------------------------------------------------
# Every value here is server-side only. Nothing is prefixed VITE_, and nothing
# here ever should be: Vite inlines anything VITE_* into the public bundle,
# which for a service-role key or a Stripe secret would mean publishing it.
#
# Production: Vercel dashboard → Project → Settings → Environment Variables.
# Local: `vercel env pull` writes .vercel/.env.development.local for
# `vercel dev`, or copy this file to .env.local and fill it in.
# ---------------------------------------------------------------------------

# The shared site password guarding the whole site.
WEBSITE_ACCESS=the-shared-password


# --- Supabase --------------------------------------------------------------
# Project → Settings → API. The service-role key bypasses row-level security,
# which is the point: every commerce table has RLS on with no policies, so
# this key is the only thing that can read or write them. Treat it like a
# database password, because that is what it is.

SUPABASE_URL=https://swlpdeyxhgkpckmyxajj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=


# --- Stripe ----------------------------------------------------------------
# Use the test keys (sk_test_… / whsec_… from `stripe listen`) until you have
# taken a real test order end to end. Swap both together — a live secret with
# a test webhook secret fails signature verification on every delivery.
#
# STRIPE_WEBHOOK_SECRET comes from the endpoint you create at
# Stripe → Developers → Webhooks, pointing at
#   https://<your-domain>/api/stripe-webhook
# subscribed to:
#   checkout.session.completed
#   checkout.session.async_payment_succeeded
#   checkout.session.async_payment_failed
#   checkout.session.expired

STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_


# --- Resend ----------------------------------------------------------------
# ORDER_FROM_EMAIL must be on a domain verified in Resend, or every send is
# rejected. The display name is part of it: "The Project London <orders@…>".
# STUDIO_ORDER_EMAIL is where the new-order notification lands.
# ORDER_REPLY_TO is optional — it defaults to STUDIO_ORDER_EMAIL.

RESEND_API_KEY=re_
ORDER_FROM_EMAIL=The Project London <orders@theprojectlondon.com>
STUDIO_ORDER_EMAIL=
ORDER_REPLY_TO=


# --- LeadConnector ---------------------------------------------------------
# Optional. Overrides the inbound webhook the gate's interest form posts to.
LEADCONNECTOR_WEBHOOK_URL=
