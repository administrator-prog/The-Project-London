# The shared site password.
#
# Production: set it in the Vercel dashboard (Project → Settings → Environment
# Variables), never in the repo.
# Local: `vercel env pull` writes it into .vercel/.env.development.local for
# `vercel dev`, or copy this file to .env.local and fill it in.
#
# Server-side only — no VITE_ prefix. Vite inlines anything prefixed VITE_
# into the public bundle, which is exactly what must not happen here.

WEBSITE_ACCESS=the-shared-password
